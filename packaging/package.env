# What the shared packaging (tools/verdite-core/packaging) calls this port.
# Read by the AppImage script, the Windows script and its installer, and
# scripts/release.sh; one KEY=VALUE a line, for bash and PowerShell alike.
NAME=Verdite3
APP_ID=verdite3
# The Inno Setup AppId: how Windows tells an upgrade of Verdite3 from another
# program. Never change it, and never give another port this one.
INNO_APP_ID=2417595D-D51B-466B-84AA-7CAE29A03A8D
# A per-user install: its shortcuts are the player's, so the game can point them
# at the card icon it reads off the disc. See "The window icon" in docs/PACKAGING.md.
INNO_PRIVILEGES=lowest
